[Unit]
Description=Genestack Console
After=network-online.target genestack-console-prepare.service
Wants=network-online.target
Requires=genestack-console-prepare.service

[Service]
Type=simple
User=genestack
Group=genestack
Environment=GSC_PREFIX=/opt/genestack-console
Environment=CONSOLE_CONFIG=/opt/genestack-console/config.yaml
WorkingDirectory=/opt/genestack-console
ExecStart=/opt/genestack-console/bin/genestack-console serve --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
